BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FESTIVAL_CODE=EST34-2026

# browser: 음성과 얼굴 모션을 브라우저에서만 실행(기본값)
# remote: FastAPI의 CosyVoice 음성 합성을 사용하고 얼굴 모션은 계속 브라우저에서 실행
NEXT_PUBLIC_VOICE_MODE=browser

# Kakao Developers > App > Platform key > JavaScript key
# Register http://localhost:3300 as a JavaScript SDK domain for local demos.
# Do not commit a real key here.
# The app also accepts NEXT_PUBLIC_KAKAO_KEY or NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_javascript_key_here

# Google Cloud Translation API (Basic/v2) key — used to auto-translate
# admin-authored content (notices, schedule, facilities, etc.) into
# English/Chinese/Japanese for visitors. See src/shared/lib/i18n/server/translate.ts
GOOGLE_TRANSLATE_API_KEY="your_google_translate_api_key_here"
